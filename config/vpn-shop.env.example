VPN_SHOP_DB=/var/lib/vpn-shop/shop.db
HOME_VPN_CONFIG=/etc/home-vpn/config.json
APP_ENV=production
PUBLIC_URL=https://vpn.my.domain.ru
APP_BIND=127.0.0.1
APP_PORT=8080
TRUST_PROXY=1
ASSET_ROOT=/srv/home-vpn/assets
DOWNLOAD_ROOT=/srv/home-vpn/downloads
TLS_CERT=
TLS_KEY=
SESSION_SECRET=generate-a-random-secret
API_SECRET=generate-a-random-secret
MAIL_SETTINGS_KEY=generate-a-separate-random-secret
ADMIN_USER=home-admin
ADMIN_PASSWORD=change-on-first-install
ADMIN_ENTRY_PATH=/private-admin-path
TELEGRAM_ADMIN_ID=0
TELEGRAM_BOT_URL=https://t.me/your_bot
BOT_ADMIN_URL=https://bot-admin.my.domain.ru/private-bot-path
BOT_ADMIN_UPSTREAM=http://127.0.0.1:8090
SMTP_HOST=mail.my.domain.ru
SMTP_PORT=587
SMTP_USERNAME=support@my.domain.ru
SMTP_PASSWORD=set-an-app-password-outside-git
SMTP_STARTTLS=1
SMTP_SSL=0
IMAP_HOST=mail.my.domain.ru
IMAP_PORT=993
IMAP_USERNAME=support@my.domain.ru
IMAP_PASSWORD=set-an-app-password-outside-git
IMAP_SSL=1
MAIL_FROM=support@my.domain.ru
MAIL_REPLY_TO=support@my.domain.ru
XUI_TOKEN=set-the-main-node-api-token
# Emergency MTProto access is disabled while any value below is empty/zero.
MTPROTO_INBOUND_ID=0
MTPROTO_PUBLIC_HOST=
MTPROTO_PUBLIC_PORT=0
MTPROTO_XUI_URL=
MTPROTO_XUI_TOKEN_ENV=FOREIGN_XUI_TOKEN
# PAYMENT_URL is intentionally empty in the public project.
PAYMENT_URL=
# Одновременно выбирается только один режим в config.json: manual или yookassa.
# Секретный ключ хранится только в /etc/vpn-shop.env.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=
# Local 3X-UI KIT archives use KIT_BACKUP_RETENTION_DAYS in the backup service.
