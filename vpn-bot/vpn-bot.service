[Unit]
Description=VPN Shop Telegram bot
After=network-online.target home-vpn-bot-egress.service
Wants=network-online.target home-vpn-bot-egress.service

[Service]
Type=simple
User=vpnshopbot
Group=vpnshopbot
EnvironmentFile=/etc/vpn-bot.env
ExecStart=/usr/bin/python3 /opt/vpn-bot/bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/vpn-bot
UMask=0077

[Install]
WantedBy=multi-user.target
